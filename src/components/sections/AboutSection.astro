---
import { Image } from "astro:assets";
import typescriptIcon from "../../assets/typescript-icon.svg";
import javascriptIcon from "../../assets/javascript.svg";
import reactIcon from "../../assets/react.svg";
import nextjsIcon from "../../assets/nextjs-icon.svg";
import nodejsIcon from "../../assets/nodejs-icon.svg";
import astroIcon from "../../assets/astro-icon.svg";
import tailwindIcon from "../../assets/tailwindcss-icon.svg";
import dockerIcon from "../../assets/docker-icon.svg";
import pythonIcon from "../../assets/python.svg";
import javaIcon from "../../assets/java.svg";
import flutterIcon from "../../assets/flutter.svg";
import dartIcon from "../../assets/dart.svg";
import figmaIcon from "../../assets/figma.svg";
import firebaseIcon from "../../assets/firebase-icon.svg";
import supabaseIcon from "../../assets/supabase-icon.svg";
import mongodbIcon from "../../assets/mongodb-icon.svg";
import postgresqlIcon from "../../assets/postgresql.svg";
import mysqlIcon from "../../assets/mysql.svg";
import redisIcon from "../../assets/redis (1).svg";
import cssIcon from "../../assets/css-3.svg";
import htmlIcon from "../../assets/html-5.svg";
import nestjsIcon from "../../assets/nestjs (1).svg";
import flaskIcon from "../../assets/flask.svg";
import springIcon from "../../assets/spring-icon.svg";
import viteIcon from "../../assets/vitejs.svg";
import remixIcon from "../../assets/remix-icon.svg";
import bunIcon from "../../assets/bun.svg";
import chartjsIcon from "../../assets/chartjs.svg";
import zodIcon from "../../assets/zod.svg";
import insomniaIcon from "../../assets/insomnia.svg";
import postmanIcon from "../../assets/postman-icon.svg";
import jiraIcon from "../../assets/jira.svg";
import confluenceIcon from "../../assets/confluence.svg";
import bitbucketIcon from "../../assets/bitbucket.svg";
import atlassianIcon from "../../assets/atlassian.svg";
import miroIcon from "../../assets/miro-icon.svg";
import photoshopIcon from "../../assets/adobe-photoshop.svg";
import playconsoleIcon from "../../assets/google-play-console-icon.svg";
import vercelIcon from "../../assets/vercel-icon.svg";
import profileImg from "../../assets/perfil.jpg";
import InteractiveSkill from "../react/InteractiveSkill.tsx";
import SoftSkillsTimeline from "../react/SoftSkillsTimeline.tsx";
import ExperienceTimeline from "../react/ExperienceTimeline.tsx";

const skills = [
    // Languages
    { name: "JavaScript", icon: javascriptIcon },
    { name: "TypeScript", icon: typescriptIcon },
    { name: "Python", icon: pythonIcon },
    { name: "Java", icon: javaIcon },
    { name: "Dart", icon: dartIcon },

    // Frontend
    { name: "HTML5", icon: htmlIcon },
    { name: "CSS3", icon: cssIcon },
    { name: "React", icon: reactIcon },
    { name: "Next.js", icon: nextjsIcon },
    { name: "Astro", icon: astroIcon },
    { name: "Remix", icon: remixIcon },
    { name: "Tailwind CSS", icon: tailwindIcon },
    { name: "Vite", icon: viteIcon },

    // Mobile
    { name: "React Native", icon: reactIcon },
    { name: "Flutter", icon: flutterIcon },

    // Backend
    { name: "Node.js", icon: nodejsIcon },
    { name: "Nest.js", icon: nestjsIcon },
    { name: "Bun", icon: bunIcon },
    { name: "Spring Boot", icon: springIcon },
    { name: "Flask", icon: flaskIcon },

    // Databases & BaaS
    { name: "PostgreSQL", icon: postgresqlIcon },
    { name: "MySQL", icon: mysqlIcon },
    { name: "MongoDB", icon: mongodbIcon },
    { name: "Redis", icon: redisIcon },
    { name: "Firebase", icon: firebaseIcon },
    { name: "Supabase", icon: supabaseIcon },

    // API & Tools
    { name: "Postman", icon: postmanIcon },
    { name: "Insomnia", icon: insomniaIcon },
    { name: "Zod", icon: zodIcon },
    { name: "Chart.js", icon: chartjsIcon },

    // DevOps & Infrastructure
    { name: "Docker", icon: dockerIcon },
    { name: "Vercel", icon: vercelIcon },
    { name: "Google Play", icon: playconsoleIcon },

    // Design & Product Management
    { name: "Figma", icon: figmaIcon },
    { name: "Photoshop", icon: photoshopIcon },
    { name: "Miro", icon: miroIcon },
    { name: "Jira", icon: jiraIcon },
    { name: "Confluence", icon: confluenceIcon },
    { name: "Atlassian", icon: atlassianIcon },
    { name: "Bitbucket", icon: bitbucketIcon },
];
---

<!-- Overlay that hides the shader behind About section -->
<div class="relative">
    <!-- Top gradient: transparent → solid (shader fades out) -->
    <div class="h-32 bg-linear-to-b from-transparent to-background"></div>

    <section
        id="about"
        class="relative py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-background"
    >
        <div class="max-w-6xl mx-auto">
            <!-- Heading -->
            <div class="mb-16 text-center">
                <span
                    class="text-primary font-mono text-sm tracking-wider uppercase"
                    >Sobre Mim</span
                >
                <h2
                    class="text-3xl sm:text-4xl md:text-5xl font-bold mt-2 text-foreground"
                >
                    Quem sou eu<span class="text-primary">.</span>
                </h2>
            </div>

            <!-- Content -->
            <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
                <!-- Text -->
                <div class="space-y-6">
                    <p
                        class="text-muted-foreground text-base sm:text-lg leading-relaxed"
                    >
                        Sou um desenvolvedor de software apaixonado por
                        tecnologia e inovação. Tenho experiência construindo
                        aplicações web e mobile modernas utilizando as melhores
                        práticas do mercado.
                    </p>
                    <p
                        class="text-muted-foreground text-base sm:text-lg leading-relaxed"
                    >
                        Atualmente focado em criar e gerenciar soluções digitais
                        que combinam performance e designs elegantes,
                        proporcionando experiências excepcionais aos usuários.
                        Sempre buscando aprender novas tecnologias e evoluir
                        como profissional.
                    </p>

                    <!-- Skills -->
                    <div class="pt-4">
                        <h3
                            class="text-sm font-mono text-primary mb-4 tracking-wider uppercase"
                        >
                            Tecnologias
                        </h3>
                        <div class="flex flex-wrap gap-3">
                            {
                                skills.map((skill) => (
                                    <InteractiveSkill
                                        client:load
                                        name={skill.name}
                                        iconSrc={skill.icon.src}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Avatar / Image placeholder -->
                <div class="flex flex-col justify-center">
                    <div class="flex justify-center mb-8">
                        <div class="relative">
                            <div
                                class="w-64 h-64 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-2xl bg-linear-to-br from-primary/20 to-primary/5 border border-border flex items-center justify-center overflow-hidden"
                            >
                                <Image
                                    src={profileImg}
                                    alt="João Gabriel"
                                    class="w-full h-full object-cover transition-all duration-500 hover:scale-105"
                                />
                            </div>
                            <!-- Decorative element -->
                            <div
                                class="absolute -z-10 -bottom-4 -right-4 w-full h-full rounded-2xl border border-primary/20"
                            >
                            </div>
                        </div>
                    </div>
                    <div class="">
                        <p
                            class="text-muted-foreground text-base italic sm:text-lg leading-relaxed"
                        >
                            Meu nome é <span class="text-primary"
                                >João Gabriel</span
                            >, universitário na FATEC São José dos Campos -
                            Prof. Jessen Vidal, atualmente cursando
                            Desenvolvimento de software multiplataforma.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Soft Skills -->
            <div class="mt-20">
                <h3
                    class="text-sm font-mono text-primary mb-4 tracking-wider uppercase text-center"
                >
                    Soft Skills
                </h3>
                <div
                    class="w-full h-[650px] md:h-[600px] rounded-2xl overflow-hidden"
                >
                    <SoftSkillsTimeline client:load />
                </div>
            </div>

            <!-- Experiências -->
            <div class="mt-20">
                <ExperienceTimeline client:load />
            </div>
        </div>
    </section>

    <!-- Bottom gradient: solid → transparent (shader fades back in for Projects) -->
    <div class="h-32 bg-linear-to-b from-background to-transparent"></div>
</div>
