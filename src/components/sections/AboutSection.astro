---
const skills = [
    "JavaScript",
    "TypeScript",
    "React",
    "React Native",
    "Node.js",
    "Astro",
    "Tailwind CSS",
    "Git",
];
---

<!-- Overlay that hides the shader behind About section -->
<div class="relative">
    <!-- Top gradient: transparent → solid (shader fades out) -->
    <div class="h-32 bg-gradient-to-b from-transparent to-background"></div>

    <section
        id="about"
        class="relative py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-background"
    >
        <div class="max-w-6xl mx-auto">
            <!-- Heading -->
            <div class="mb-16 text-center">
                <span
                    class="text-primary font-mono text-sm tracking-wider uppercase"
                    >Sobre Mim</span
                >
                <h2
                    class="text-3xl sm:text-4xl md:text-5xl font-bold mt-2 text-foreground"
                >
                    Quem sou eu<span class="text-primary">.</span>
                </h2>
            </div>

            <!-- Content -->
            <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
                <!-- Text -->
                <div class="space-y-6">
                    <p
                        class="text-muted-foreground text-base sm:text-lg leading-relaxed"
                    >
                        Sou um desenvolvedor de software apaixonado por
                        tecnologia e inovação. Tenho experiência construindo
                        aplicações web e mobile modernas utilizando as melhores
                        práticas do mercado.
                    </p>
                    <p
                        class="text-muted-foreground text-base sm:text-lg leading-relaxed"
                    >
                        Atualmente focado em criar experiências digitais que
                        combinam design elegante com performance excepcional.
                        Sempre buscando aprender novas tecnologias e evoluir
                        como profissional.
                    </p>

                    <!-- Skills -->
                    <div class="pt-4">
                        <h3
                            class="text-sm font-mono text-primary mb-4 tracking-wider uppercase"
                        >
                            Tecnologias
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            {
                                skills.map((skill) => (
                                    <span class="px-3 py-1.5 text-xs sm:text-sm font-medium bg-card border border-border rounded-lg text-muted-foreground hover:border-primary/50 hover:text-foreground transition-colors cursor-default">
                                        {skill}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Avatar / Image placeholder -->
                <div class="flex justify-center">
                    <div class="relative">
                        <div
                            class="w-64 h-64 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-2xl bg-gradient-to-br from-primary/20 to-primary/5 border border-border flex items-center justify-center overflow-hidden"
                        >
                            <div class="text-center p-6">
                                <div
                                    class="w-20 h-20 mx-auto mb-4 rounded-full bg-primary/20 flex items-center justify-center"
                                >
                                    <span class="text-3xl">👨‍💻</span>
                                </div>
                                <p class="text-muted-foreground text-sm">
                                    Sua foto aqui
                                </p>
                            </div>
                        </div>
                        <!-- Decorative element -->
                        <div
                            class="absolute -z-10 -bottom-4 -right-4 w-full h-full rounded-2xl border border-primary/20"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom gradient: solid → transparent (shader fades back in for Projects) -->
    <div class="h-32 bg-gradient-to-b from-background to-transparent"></div>
</div>
