---
const navLinks = [
    { label: "Home", href: "#home" },
    { label: "Sobre", href: "#about" },
    { label: "Projetos", href: "#projects" },
];
---

<nav
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a
                href="#home"
                class="text-xl font-bold text-text-primary hover:text-accent-light transition-colors"
            >
                &lt;João /&gt;
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-8">
                {
                    navLinks.map((link) => (
                        <a
                            href={link.href}
                            class="text-sm font-medium text-text-secondary hover:text-text-primary transition-colors relative group"
                        >
                            {link.label}
                            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent group-hover:w-full transition-all duration-300" />
                        </a>
                    ))
                }
            </div>

            <!-- Mobile hamburger -->
            <button
                id="menu-toggle"
                class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
                aria-label="Abrir menu"
            >
                <span
                    class="block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"
                    id="bar1"></span>
                <span
                    class="block w-6 h-0.5 bg-text-primary transition-all duration-300"
                    id="bar2"></span>
                <span
                    class="block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"
                    id="bar3"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden">
        <div
            class="px-4 py-4 bg-bg-secondary/95 backdrop-blur-xl border-t border-border"
        >
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class="mobile-link block py-3 text-base font-medium text-text-secondary hover:text-text-primary hover:pl-2 transition-all duration-200"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>
</nav>

<script>
    const navbar = document.getElementById("navbar");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const bar1 = document.getElementById("bar1");
    const bar2 = document.getElementById("bar2");
    const bar3 = document.getElementById("bar3");
    let isOpen = false;

    // Scroll effect — add backdrop blur on scroll
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            navbar?.classList.add(
                "bg-bg-primary/80",
                "backdrop-blur-xl",
                "border-b",
                "border-border",
            );
        } else {
            navbar?.classList.remove(
                "bg-bg-primary/80",
                "backdrop-blur-xl",
                "border-b",
                "border-border",
            );
        }
    });

    // Mobile menu toggle
    menuToggle?.addEventListener("click", () => {
        isOpen = !isOpen;
        mobileMenu?.classList.toggle("hidden");

        if (isOpen) {
            bar1?.classList.add("rotate-45", "translate-y-[4px]");
            bar2?.classList.add("opacity-0");
            bar3?.classList.add("-rotate-45", "-translate-y-[4px]");
        } else {
            bar1?.classList.remove("rotate-45", "translate-y-[4px]");
            bar2?.classList.remove("opacity-0");
            bar3?.classList.remove("-rotate-45", "-translate-y-[4px]");
        }
    });

    // Close mobile menu on link click
    document.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => {
            isOpen = false;
            mobileMenu?.classList.add("hidden");
            bar1?.classList.remove("rotate-45", "translate-y-[4px]");
            bar2?.classList.remove("opacity-0");
            bar3?.classList.remove("-rotate-45", "-translate-y-[4px]");
        });
    });
</script>
